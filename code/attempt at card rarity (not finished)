#include <stdio.h>
#include <stdlib.h>
#include <time.h>


int main(void) {
    int deck[12];

    srand(time(NULL));
    
    for (int i = 0; i < 12; i++) {
        int rare = rand() %100;
        printf("%d\n",rare);
        if(rare<50){
            deck[i] = rand() % (4-1+1)+1; 
            printf("common\n\n");
        }
        else if(rare<80){
            deck[i] = rand() % (20-5+1) + 5; 
            printf("uncommon\n\n");
        }
        else if(rare<95){
            deck[i] = rand() % (28-21+1) + 1;  
            printf("rare\n\n");
        }
        else{
            deck[i] = rand() % (30-29+1) + 1; 
            printf("epic\n\n");
        }
    }
        for (int i = 0; i < 12; i++) {
            printf("%d\n", deck[i]);
        }
    

    return 0;
}
